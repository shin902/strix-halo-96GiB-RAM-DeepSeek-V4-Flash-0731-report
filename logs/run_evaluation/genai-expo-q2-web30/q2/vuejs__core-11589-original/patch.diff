+import { ref, computed, watch } from '../vue/src'
+
+describe('repro', () => {
+  it('ref sync watchers', () => {
+    const n = ref(0)
+    const calls: number[] = []
+    for (let i = 0; i < 5; i++) {
+      watch(n, (v) => {
+        calls.push(i)
+      }, { flush: 'sync' })
+    }
+    n.value++
+    console.log('ref calls:', calls)
+  })
+
+  it('computed sync watchers', () => {
+    const n = ref(0)
+    const compN = computed(() => n.value)
+    const calls: number[] = []
+    for (let i = 0; i < 5; i++) {
+      watch(compN, (v) => {
+        calls.push(i)
+      }, { flush: 'sync' })
+    }
+    n.value++
+    console.log('computed calls:', calls)
+  })
+})
